<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Kivi.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Kivi">
    <Grid Background="#041F1D" Loaded="Root_Loaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#062A27" BorderBrush="#16443D" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="20,24,20,0" Spacing="2">
                    <TextBlock Text="Kivi" Foreground="#5EF2D6" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="локальный ассистент" Foreground="#8FB8B0" FontSize="11"/>
                    <Button Content="＋  Новый чат" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Margin="0,14,0,0" Click="NewChat_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#E4F7F1"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="4,14,4,0" Spacing="2">
                    <Button Content="💬  Чат" Tag="chat" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="#0B3A34" BorderThickness="0" Foreground="#E4F7F1" Padding="14,10"/>
                    <Button Content="🎙  Голоса" Tag="voices" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#8FB8B0" Padding="14,10"/>
                    <Button Content="🖼  Медиа" Tag="media" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#8FB8B0" Padding="14,10"/>
                    <Button Content="📁  Файлы" Tag="files" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#8FB8B0" Padding="14,10"/>
                    <Button Content="👤  CRM" Tag="crm" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#8FB8B0" Padding="14,10"/>
                    <Button Content="⚙  Настройки" Tag="settings" Click="Nav_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#8FB8B0" Padding="14,10"/>
                </StackPanel>
                <Border Grid.Row="2" Margin="12,0,12,16" Padding="12,9" CornerRadius="10" Background="#06312C" BorderBrush="#16443D" BorderThickness="1">
                    <StackPanel Spacing="3">
                        <TextBlock x:Name="VersionText" Text="онлайн · v—" Foreground="#5EF2D6" FontSize="12"/>
                        <TextBlock x:Name="ConnectionText" Text="API: проверка…" Foreground="#8FB8B0" FontSize="10"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#16443D" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <TextBlock x:Name="PageTitle" Text="Чат" Foreground="#E4F7F1" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="Kivi · WinUI 3" Foreground="#8FB8B0" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid x:Name="ChatView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="MessagesScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="36,26,36,16">
                        <StackPanel x:Name="MessagesPanel" MaxWidth="880" HorizontalAlignment="Center"/>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="36,10,36,24" Padding="14" CornerRadius="18" Background="#082F2B" BorderBrush="#16443D" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ComposerInput" Grid.Row="0" PlaceholderText="Напишите Kivi…" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48" MaxHeight="150" Background="Transparent" BorderThickness="0" Foreground="#E4F7F1" FontSize="14" KeyDown="ComposerInput_KeyDown"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                                <Button Content="🎙" ToolTipService.ToolTip="Голосовой ввод" Background="Transparent" BorderThickness="0" Foreground="#8FB8B0" Click="Mic_Click"/>
                                <Button Content="⌁" ToolTipService.ToolTip="Слушать Kivi" Background="Transparent" BorderThickness="0" Foreground="#8FB8B0" Click="Wake_Click"/>
                                <Button Content="🔊" ToolTipService.ToolTip="Автоозвучивание" Background="Transparent" BorderThickness="0" Foreground="#8FB8B0" Click="Speak_Click"/>
                                <Button Content="➤" Click="Send_Click" HorizontalAlignment="Right" Background="#123F38" Foreground="#5EF2D6" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="PageView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="36,26,36,26">
                    <StackPanel x:Name="PagePanel" MaxWidth="920" HorizontalAlignment="Center"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
