<Window x:Class="Kivi.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kivi" Height="900" Width="1440" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,18">
                    <TextBlock Text="Kivi" Foreground="{StaticResource Mint}" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="локальный ассистент" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <Border Background="#06312C" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="онлайн · v0.20.0" Foreground="{StaticResource Mint}" FontSize="12"/>
                            <TextBlock x:Name="ConnectionText" Text="API: проверка…" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="4,0">
                    <Button x:Name="ChatNav" Style="{StaticResource NavButton}" Content="  Чат" Tag="chat" Click="Nav_Click"/>
                    <Button x:Name="VoicesNav" Style="{StaticResource NavButton}" Content="  Голоса" Tag="voices" Click="Nav_Click"/>
                    <Button x:Name="MediaNav" Style="{StaticResource NavButton}" Content="  Медиа" Tag="media" Click="Nav_Click"/>
                    <Button x:Name="FilesNav" Style="{StaticResource NavButton}" Content="  Файлы" Tag="files" Click="Nav_Click"/>
                    <Button x:Name="CrmNav" Style="{StaticResource NavButton}" Content="  CRM" Tag="crm" Click="Nav_Click"/>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="  Настройки" Tag="settings" Click="Nav_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" Grid.Column="0" Text="Чат" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Kivi Desktop · native XAML" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid x:Name="ChatView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="MessagesScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="36,26,36,16">
                        <StackPanel x:Name="MessagesPanel" MaxWidth="880" HorizontalAlignment="Center">
                            <TextBlock Text="СЕГОДНЯ" Foreground="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,22"/>

                            <Border Background="#0A3A34" CornerRadius="15,15,4,15" Padding="16,12" HorizontalAlignment="Right" MaxWidth="560" Margin="120,0,0,18">
                                <TextBlock Text="Привет, Kivi" Foreground="{StaticResource Text}" FontSize="14" TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4,15,15,15" Padding="16,12" HorizontalAlignment="Left" MaxWidth="620" Margin="0,0,120,18">
                                <StackPanel>
                                    <TextBlock Text="Привет! Я Kivi. Чем помочь?" Foreground="{StaticResource Text}" FontSize="14" TextWrapping="Wrap"/>
                                    <TextBlock Text="Kivi · сейчас" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Margin="36,10,36,24" Background="{StaticResource Panel2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="18" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="ComposerInput" Grid.Row="0" TextWrapping="Wrap" AcceptsReturn="True"
                                     MinHeight="48" MaxHeight="150" Foreground="{StaticResource Text}"
                                     Background="Transparent" BorderThickness="0" FontSize="14"
                                     VerticalContentAlignment="Top" Padding="6,6"
                                     KeyDown="ComposerInput_KeyDown"/>
                            <DockPanel Grid.Row="1" Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <Button Style="{StaticResource ToolButton}" Content="🎙" ToolTip="Голосовой ввод"/>
                                    <Button Style="{StaticResource ToolButton}" Content="⌁" ToolTip="Слушать Kivi"/>
                                    <Button Style="{StaticResource ToolButton}" Content="🔊" ToolTip="Автоозвучивание"/>
                                    <TextBlock Text="Enter — отправить · Shift+Enter — перенос" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource SendButton}" Content="➤" Click="Send_Click"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="PlaceholderView" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="PlaceholderTitle" Text="Раздел" Foreground="{StaticResource Text}" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Нативный XAML-раздел будет перенесён из текущего UI." Foreground="{StaticResource Muted}" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
